      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\n\n// Test 1: Validate total number of IDs across all pages\npm.test(\"Total number of IDs is 12\", function () {\n    pm.expect(jsonData.total).to.eql(12);\n});\n\n// Test 2: Validate number of IDs returned on current page\npm.test(\"Number of IDs on current page is 6\", function () {\n    pm.expect(jsonData.data.length).to.eql(6);\n});\n\n// Test 3: Validate all items in data array have an id field\npm.test(\"All records have an id field\", function () {\n    jsonData.data.forEach(function(item) {\n        pm.expect(item).to.have.property('id');\n    });\n});\n\n// Log the IDs for visibility\nconst ids = jsonData.data.map(item => item.id);\nconsole.log(\"Total IDs (all pages):\", jsonData.total);\nconsole.log(\"IDs on this page:\", ids);"
            ]
          }
